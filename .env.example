# ════════════════════════════════════════════════
#  PET GESTOR — Variáveis de Ambiente
#  1. Copie este arquivo para .env
#  2. Preencha com seus dados do Supabase
#  3. NUNCA commite o .env no Git
# ════════════════════════════════════════════════

# ── Supabase (obrigatório) ───────────────────────
# Encontre em: supabase.com → seu projeto → Settings → API
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_KEY=SUA_ANON_KEY_AQUI

# ── Admin Master (opcional) ──────────────────────
# Cole aqui o seu User ID do Supabase
# Encontre em: Authentication → Users → clique no seu usuário → User UID
VITE_ADMIN_UID=SEU_USER_ID_AQUI

# ── Service Role (apenas para Admin Master) ──────
# ⚠️ NUNCA exponha esta chave no frontend em produção
# Use apenas localmente ou via Edge Functions
# Encontre em: Settings → API → service_role key
VITE_SUPABASE_SERVICE_KEY=SUA_SERVICE_ROLE_KEY_AQUI
